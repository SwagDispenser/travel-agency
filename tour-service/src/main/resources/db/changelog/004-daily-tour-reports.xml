<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="004-create-daily-tour-reports" author="dmytro">
        <createTable tableName="daily_tour_reports">
            <column name="report_date" type="DATE"><constraints primaryKey="true" nullable="false"/></column>
            <column name="country" type="VARCHAR(80)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="horizon_days" type="INT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tour_count" type="BIGINT"><constraints nullable="false"/></column>
            <column name="available_seats" type="BIGINT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
