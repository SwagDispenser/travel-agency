{
  "realm": "travel-agency",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Regular travel agency user"
      },
      {
        "name": "ADMIN",
        "description": "Travel agency administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "travel-agency-ui",
      "name": "Travel Agency UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "travel-agency-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "realmRoles": [
        "USER",
        "ADMIN"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    },
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Regular",
      "lastName": "User",
      "realmRoles": [
        "USER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ]
    }
  ]
}
