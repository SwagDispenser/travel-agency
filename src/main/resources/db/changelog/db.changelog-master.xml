<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-tours" author="dmytro">
        <createTable tableName="tours">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="available_seats" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="featured" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-seed-tours" author="dmytro">
        <insert tableName="tours">
            <column name="title" value="Weekend in Krakow"/>
            <column name="country" value="Poland"/>
            <column name="city" value="Krakow"/>
            <column name="description" value="Short city tour with hotel and guided walk."/>
            <column name="start_date" valueDate="2026-10-10"/>
            <column name="end_date" valueDate="2026-10-12"/>
            <column name="price" valueNumeric="220.00"/>
            <column name="available_seats" valueNumeric="12"/>
            <column name="featured" valueBoolean="true"/>
        </insert>
        <insert tableName="tours">
            <column name="title" value="Barcelona Basic"/>
            <column name="country" value="Spain"/>
            <column name="city" value="Barcelona"/>
            <column name="description" value="Simple beach and sightseeing package."/>
            <column name="start_date" valueDate="2026-11-03"/>
            <column name="end_date" valueDate="2026-11-08"/>
            <column name="price" valueNumeric="540.00"/>
            <column name="available_seats" valueNumeric="8"/>
            <column name="featured" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
